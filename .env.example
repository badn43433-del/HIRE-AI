# ==============================================================================
# HireShield AI - 100% Open-Source Local AI Environment Configuration
# ZERO PAID APIS REQUIRED (No OpenAI, No Gemini, No Claude, No Cloud Vision)
# ==============================================================================

# Application Port & Host
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000

# Backend FastAPI Configuration
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0
FASTAPI_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & Authentication (JWT Secret for local token signing)
JWT_SECRET=hireshield_local_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (Supabase PostgreSQL or Local PostgreSQL)
# For Supabase Cloud:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Or Direct PostgreSQL Connection String:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hireshield_db

# Local AI Engine Inference Device
# Options: "cpu" or "cuda" (for NVIDIA GPU acceleration with PyTorch)
AI_INFERENCE_DEVICE=cpu

# Local Vision & Proctoring Engine Settings
OPENCV_FPS_TARGET=30
MEDIAPIPE_MAX_FACES=2
GAZE_TOLERANCE_DEGREES=22.0
GAZE_ALERT_THRESHOLD_SECONDS=4.0
YOLO_MODEL_PATH=./backend/weights/yolov8n.pt

# Local Speech-to-Text (Whisper running locally on server)
# Model size: "tiny", "base", or "small" (runs fast on standard CPU)
WHISPER_MODEL_SIZE=base

# Cross-Network Expo Go Backend URL (set in .env.local when using npm run tunnel)
EXPO_PUBLIC_API_URL=https://your-https-tunnel-or-cloud-url.example.com
