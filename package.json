{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "tsx server.ts",
    "expo": "npx expo start",
    "expo:start": "npx expo start",
    "tunnel": "npx expo start --tunnel ngrok",
    "android": "npx expo start --android",
    "expo:web": "npx expo start --web",
    "expo:android": "npx expo start --android",
    "expo:ios": "npx expo start --ios",
    "backend": "uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js CJS dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.104.4",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.4.2",
    "expo": "^58.0.14",
    "expo-constants": "^58.0.12",
    "expo-linking": "^58.0.13",
    "expo-router": "^58.0.23",
    "expo-status-bar": "^58.0.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-native": "^0.88.0",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.30.0",
    "react-native-web": "^0.21.4",
    "react-router-dom": "^7.15.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
